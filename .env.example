DATABASE_URL=postgresql://pos:pos@localhost:5432/pos

# Product placeholders (change when the name/domain are chosen)
APP_NAME=InChouf
# Root domain without protocol. Locally: localhost:3000 (shops at <slug>.localhost:3000)
ROOT_DOMAIN=localhost:3000

# Better Auth: long random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
# Used to encrypt device passcodes (openssl rand -base64 32)
APP_SECRET=change-me


# Contact details shown on the landing page (optional)
CONTACT_WHATSAPP=+9613000000
CONTACT_EMAIL=hello@example.com

# ---- Production only (docker-compose.prod.yml) ----
# ROOT_DOMAIN=example.com
# POSTGRES_PASSWORD=<long random password>
# ACME_EMAIL=you@example.com   # Let's Encrypt account e-mail for HTTPS certificates

# Hosted Postgres with its own CA (e.g. Supabase): path to the root certificate.
# DATABASE_CA_CERT=./certs/supabase-prod-ca-2021.crt

# Subdomain of the super admin panel (default "admin")
# ADMIN_SUBDOMAIN=admin
