# Automatic HTTPS for the main domain, admin.<domain> and every shop subdomain.
# "On-demand TLS" issues a certificate the first time a hostname is visited, after asking the app
# whether that hostname is ours (/api/tls-check). No wildcard certificate or DNS API is needed:
# only a wildcard DNS record (*.example.com → this server).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
