generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money: USD in cents, LBP in whole pounds. Columns named *UsdCents are USD cents.

enum Locale {
  EN
  AR
}

enum Currency {
  USD
  LBP
}

enum Role {
  OWNER
  TECHNICIAN
  CASHIER
}

enum SubStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TicketStatus {
  RECEIVED
  DIAGNOSING
  WAITING_PART
  REPAIRING
  READY
  PICKED_UP
  CANCELLED
  CANT_FIX
}

enum ItemKind {
  PART
  LABOR
}

enum ProductType {
  ACCESSORY
  PART
  PHONE
}

enum MovementReason {
  INITIAL
  SALE
  TICKET_PART
  RESTOCK
  ADJUSTMENT
  DAMAGED
  RETURN
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum SaleItemKind {
  PRODUCT
  TICKET_BALANCE
}

enum PaymentMethod {
  CASH
  WHISH
  OMT
  CARD
  BANK_TRANSFER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

enum PartOrderStatus {
  ORDERED
  ARRIVED
  CANCELLED
}

enum TicketMediaKind {
  PHOTO
  SIGNATURE
}

enum ExpenseCategory {
  RENT
  GENERATOR
  ELECTRICITY
  SALARIES
  INTERNET
  SUPPLIES
  OTHER
}

enum TemplateKey {
  TICKET_RECEIVED
  TICKET_READY
  TICKET_WAITING_PART
  TICKET_CANT_FIX
  BALANCE_REMINDER
}

// ---------- Platform ----------

model Shop {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  logoUrl             String?
  address             String?
  phone               String?
  defaultLocale       Locale    @default(EN)
  exchangeRate        Int       @default(89500) // LBP per 1 USD
  lbpRounding         Int       @default(1000)
  defaultWarrantyDays Int       @default(30)
  storageFreeDays     Int       @default(30) // days a ready phone waits free before the storage fee starts
  storageFeeUsdCents  Int       @default(0) // storage fee per extra day; 0 = no fee
  receiptFooter       String?
  receiptFooterAr     String?
  termsText           String?
  termsTextAr         String?
  ticketPrefix        String    @default("R-")
  timezone            String    @default("Asia/Beirut") // IANA zone for days in reports and dates
  countryCode         String    @default("961") // default calling code for local phone numbers
  ticketSeq           Int       @default(1000)
  saleSeq             Int       @default(1000)
  planId              String?
  subscriptionStatus  SubStatus @default(TRIAL)
  paidUntil           DateTime?
  trialEndsAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  plan                 Plan?                 @relation(fields: [planId], references: [id])
  users                User[]
  customers            Customer[]
  brands               DeviceBrand[]
  models               DeviceModel[]
  tickets              Ticket[]
  ticketItems          TicketItem[]
  ticketStatusLogs     TicketStatusLog[]
  ticketNotes          TicketNote[]
  priceApprovals       PriceApproval[]
  products             Product[]
  stockMovements       StockMovement[]
  sales                Sale[]
  saleItems            SaleItem[]
  payments             Payment[]
  cashSessions         CashSession[]
  cashMovements        CashMovement[]
  expenses             Expense[]
  repairPrices         RepairPrice[]
  ticketMedia          TicketMedia[]
  partOrders           PartOrder[]
  suppliers            Supplier[]
  purchases            Purchase[]
  purchaseItems        PurchaseItem[]
  supplierPayments     SupplierPayment[]
  templates            MessageTemplate[]
  exchangeRates        ExchangeRate[]
  subscriptionPayments SubscriptionPayment[]
  auditLogs            AuditLog[]
  presets              ShopPreset[]
  installmentPlans     InstallmentPlan[]
  installments         Installment[]
  logo                 ShopLogo?
}

// Shop logo bytes (PNG/JPG/WEBP, ≤ 1 MB). Kept in the database so the app needs no disk storage
// (works on serverless hosts like Vercel and in Docker alike).
model ShopLogo {
  shopId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// Platform-wide settings (single row, id "platform"), edited by the super admin.
model PlatformSetting {
  id               String   @id @default("platform")
  appName          String   @default("InChouf")
  contactWhatsapp  String?
  contactEmail     String?
  // Shop whose live (demo) data illustrates the landing page.
  showcaseShopSlug String?
  // Copied into every new shop: { TICKET_READY: { EN, AR }, ... }
  defaultTemplates Json?
  // Copied into every new shop: [{ kind, labelEn, labelAr }]
  defaultPresets   Json?
  updatedAt        DateTime @updatedAt
}

enum PresetKind {
  PROBLEM // quick-pick problems on the repair intake form
  PAY_IN // quick reasons for cash put into the drawer
  PAY_OUT // quick reasons for cash taken out of the drawer
}

// Shop-editable quick picks (bilingual).
model ShopPreset {
  id        String     @id @default(cuid())
  shopId    String
  kind      PresetKind
  labelEn   String
  labelAr   String
  sort      Int        @default(0)
  createdAt DateTime   @default(now())
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, kind, sort])
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  priceUsdCents Int
  maxStaff      Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shops         Shop[]
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  shopId         String
  amountUsdCents Int
  method         String
  periodStart    DateTime
  periodEnd      DateTime
  note           String?
  recordedById   String
  createdAt      DateTime @default(now())
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  shopId    String
  rate      Int
  setById   String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  setBy     User     @relation(fields: [setById], references: [id])

  @@index([shopId, createdAt])
}

// ---------- Auth (Better Auth core tables + our fields) ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  shopId        String?
  role          Role      @default(CASHIER)
  isSuperAdmin  Boolean   @default(false)
  locale        Locale?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  shop             Shop?             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedTickets  Ticket[]          @relation("assignedTo")
  createdTickets   Ticket[]          @relation("createdBy")
  statusLogs       TicketStatusLog[]
  ticketNotes      TicketNote[]
  priceApprovals   PriceApproval[]
  stockMovements   StockMovement[]
  sales            Sale[]
  payments         Payment[]
  openedSessions   CashSession[]     @relation("openedBy")
  closedSessions   CashSession[]     @relation("closedBy")
  cashMovements    CashMovement[]
  expenses         Expense[]
  ticketMedia      TicketMedia[]
  partOrders       PartOrder[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  installmentPlans InstallmentPlan[]
  approvalAnswers  PriceApproval[]   @relation("approvalAnswers")
  exchangeRatesSet ExchangeRate[]
  auditLogs        AuditLog[]

  @@index([shopId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Customers ----------

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  phone     String // E.164
  phoneAlt  String?
  notes     String?
  locale    Locale   @default(EN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  sales            Sale[]
  installmentPlans InstallmentPlan[]

  @@unique([shopId, phone])
  @@index([shopId, name])
}

// ---------- Device catalog (shopId null = global) ----------

model DeviceBrand {
  id        String        @id @default(cuid())
  shopId    String?
  name      String
  createdAt DateTime      @default(now())
  shop      Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  models    DeviceModel[]

  @@unique([shopId, name])
}

model DeviceModel {
  id        String        @id @default(cuid())
  shopId    String?
  brandId   String
  name      String
  createdAt DateTime      @default(now())
  shop      Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brand     DeviceBrand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  products  Product[]     @relation("ProductCompatibility")
  prices    RepairPrice[]

  @@unique([brandId, name])
}

// Shop price list for repairs ("iPhone 13 · Screen = $120"). No model = the price for any model.
// One price per (model, service): unique index on (shopId, COALESCE(deviceModelId, ''), lower(service)) in SQL.
model RepairPrice {
  id            String   @id @default(cuid())
  shopId        String
  deviceModelId String?
  service       String
  priceUsdCents Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  @@index([shopId, deviceModelId])
}

// ---------- Repair tickets ----------

model Ticket {
  id               String       @id @default(cuid())
  shopId           String
  number           Int
  customerId       String
  deviceModelId    String?
  brandText        String?
  modelText        String?
  imei             String?
  color            String?
  problem          String
  passcodeEnc      String?
  patternEnc       String?
  accessories      String[]
  conditionNotes   String?
  estimateUsdCents Int?
  promisedAt       DateTime?
  status           TicketStatus @default(RECEIVED)
  assignedToId     String?
  warrantyDays     Int
  pickedUpAt       DateTime?
  totalUsdCents    Int          @default(0)
  createdById      String
  createdAt        DateTime     @default(now())
  /// Secret for the public track link (/track?k=…), so the customer sees progress without typing anything.
  pickupReminders  Int          @default(0) // pickup reminders sent since it became Ready (day 3, 14, 30)
  pickupRemindedAt DateTime?
  storageItemId    String? // the "storage fee" line on this ticket, updated instead of duplicated
  /// After pickup: when the 3-day "how is your phone?" message was sent.
  checkSentAt      DateTime?
  /// Check-in checklist: { SCREEN: "ok" | "issue" | "na", … } (features/checkin/rules.ts).
  checklist        Json?
  /// Set on a warranty comeback: the original repair this phone came back from (repaired free).
  comebackOfId     String?
  trackToken       String       @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  updatedAt        DateTime     @updatedAt

  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id])
  deviceModel     DeviceModel?      @relation(fields: [deviceModelId], references: [id])
  assignedTo      User?             @relation("assignedTo", fields: [assignedToId], references: [id])
  comebackOf      Ticket?           @relation("comeback", fields: [comebackOfId], references: [id], onDelete: SetNull)
  comebacks       Ticket[]          @relation("comeback")
  media           TicketMedia[]
  partOrders      PartOrder[]
  installmentPlan InstallmentPlan?
  createdBy       User              @relation("createdBy", fields: [createdById], references: [id])
  items           TicketItem[]
  statusLogs      TicketStatusLog[]
  notes           TicketNote[]
  approvals       PriceApproval[]
  payments        Payment[]
  saleItems       SaleItem[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, imei])
  @@index([shopId, assignedToId])
  @@index([shopId, comebackOfId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([customerId])
  @@index([deviceModelId])
}

model TicketItem {
  id                String   @id @default(cuid())
  shopId            String
  ticketId          String
  kind              ItemKind
  productId         String?
  description       String
  qty               Int      @default(1)
  unitPriceUsdCents Int
  unitCostUsdCents  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket         Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([shopId, ticketId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([ticketId])
  @@index([productId])
}

model TicketStatusLog {
  id        String        @id @default(cuid())
  shopId    String
  ticketId  String
  from      TicketStatus?
  to        TicketStatus
  userId    String
  note      String?
  createdAt DateTime      @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([shopId, ticketId, createdAt])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([ticketId])
}

model TicketNote {
  id        String   @id @default(cuid())
  shopId    String
  ticketId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([shopId, ticketId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([ticketId])
}

// ---------- Inventory ----------

model Product {
  id                String      @id @default(cuid())
  shopId            String
  type              ProductType
  name              String
  sku               String?
  barcode           String?
  category          String?
  costUsdCents      Int         @default(0)
  priceUsdCents     Int
  qty               Int         @default(0)
  lowStockThreshold Int         @default(2)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  shop             Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  compatibleModels DeviceModel[]   @relation("ProductCompatibility")
  stockMovements   StockMovement[]
  ticketItems      TicketItem[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, type, name])
}

model StockMovement {
  id           String         @id @default(cuid())
  shopId       String
  productId    String
  delta        Int
  qtyAfter     Int
  reason       MovementReason
  note         String?
  saleId       String?
  ticketItemId String?
  userId       String
  createdAt    DateTime       @default(now())

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id])
  ticketItem TicketItem? @relation(fields: [ticketItemId], references: [id], onDelete: SetNull)
  user       User        @relation(fields: [userId], references: [id])

  @@index([shopId, productId, createdAt])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([productId])
  @@index([saleId])
  @@index([ticketItemId])
}

// ---------- Sales & payments (recorded, never processed) ----------

model Sale {
  id               String     @id @default(cuid())
  shopId           String
  number           Int
  customerId       String?
  subtotalUsdCents Int
  discountUsdCents Int        @default(0)
  totalUsdCents    Int
  changeAmount     Int        @default(0)
  changeCurrency   Currency?
  status           SaleStatus @default(COMPLETED)
  cashierId        String
  cashSessionId    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id])
  cashier         User             @relation(fields: [cashierId], references: [id])
  cashSession     CashSession?     @relation(fields: [cashSessionId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  installmentPlan InstallmentPlan?
  stockMovements  StockMovement[]

  @@unique([shopId, number])
  @@index([shopId, createdAt])
  @@index([shopId, customerId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([cashSessionId])
  @@index([customerId])
}

model SaleItem {
  id                String       @id @default(cuid())
  shopId            String
  saleId            String
  kind              SaleItemKind
  productId         String?
  ticketId          String?
  description       String
  qty               Int          @default(1)
  unitPriceUsdCents Int
  unitCostUsdCents  Int          @default(0)
  discountUsdCents  Int          @default(0)

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  ticket  Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([shopId, saleId])
  @@index([shopId, ticketId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([saleId])
  @@index([ticketId])
  @@index([productId])
}

model Payment {
  id                 String        @id @default(cuid())
  shopId             String
  saleId             String?
  ticketId           String?
  method             PaymentMethod
  currency           Currency
  amount             Int // cents if USD, pounds if LBP
  rate               Int // LBP per USD at the time of payment
  usdCentsEquivalent Int
  reference          String?
  cashSessionId      String?
  userId             String
  createdAt          DateTime      @default(now())

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
  @@index([shopId, ticketId])
  @@index([shopId, cashSessionId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([saleId])
  @@index([ticketId])
  @@index([cashSessionId])
}

// ---------- Cash drawer ----------

model CashSession {
  id               String    @id @default(cuid())
  shopId           String
  openedById       String
  openedAt         DateTime  @default(now())
  closedById       String?
  closedAt         DateTime?
  openingUsdCents  Int
  openingLbp       Int
  countedUsdCents  Int?
  countedLbp       Int?
  expectedUsdCents Int?
  expectedLbp      Int?
  note             String?

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  openedBy  User           @relation("openedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("closedBy", fields: [closedById], references: [id])
  sales     Sale[]
  payments  Payment[]
  movements CashMovement[]

  @@index([shopId, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  shopId        String
  cashSessionId String
  type          CashMovementType
  currency      Currency
  amount        Int
  reason        String
  userId        String
  createdAt     DateTime         @default(now())

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashSession     CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  expense         Expense?
  supplierPayment SupplierPayment?

  @@index([shopId, cashSessionId])
  // Child lookups by foreign key (balances, reports, cascades).
  @@index([cashSessionId])
}

// Running costs (rent, generator, salaries…) for real profit. Amount is in its own currency
// (USD cents / whole LBP); usdCentsEquivalent is fixed at the shop rate when recorded.
model Expense {
  id                 String          @id @default(cuid())
  shopId             String
  category           ExpenseCategory
  note               String?
  currency           Currency
  amount             Int
  usdCentsEquivalent Int
  spentAt            DateTime
  /// Set when it was paid out of the open cash drawer (a PAY_OUT movement).
  cashMovementId     String?         @unique
  userId             String
  createdAt          DateTime        @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)

  @@index([shopId, spentAt])
}

// Check-in photos and the customer's signature, stored in the database (like ShopLogo) so no disk or
// outside storage is needed. Photos are shrunk on the device before upload (≈200–400 KB).
model TicketMedia {
  id        String          @id @default(cuid())
  shopId    String
  ticketId  String
  kind      TicketMediaKind
  mime      String
  data      Bytes
  userId    String
  createdAt DateTime        @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([shopId, ticketId])
}

// A part ordered from a supplier for a repair: who it was ordered from, when it should arrive, and
// whether the customer was told. Supplier is plain text for now (suppliers get their own table later).
model PartOrder {
  id             String          @id @default(cuid())
  shopId         String
  ticketId       String
  part           String
  qty            Int             @default(1)
  supplierName   String
  supplierPhone  String?
  costUsdCents   Int?
  status         PartOrderStatus @default(ORDERED)
  /// Local day the part should arrive, stored at local noon.
  expectedAt     DateTime
  arrivedAt      DateTime?
  supplierSentAt DateTime?
  customerToldAt DateTime?
  note           String?
  userId         String
  createdAt      DateTime        @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([shopId, status, expectedAt])
  @@index([shopId, ticketId])
}

// Wholesalers the shop buys stock from. Owed = purchases − payments (USD cents).
model Supplier {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([shopId, name])
}

// Stock bought from a supplier (priced in USD). Items go into stock and update the product's average cost.
model Purchase {
  id            String   @id @default(cuid())
  shopId        String
  supplierId    String
  /// Supplier's invoice number, if any.
  reference     String?
  totalUsdCents Int
  /// Local day of the purchase, stored at local noon.
  purchasedAt   DateTime
  note          String?
  userId        String
  createdAt     DateTime @default(now())

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User              @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@index([shopId, supplierId, purchasedAt])
}

model PurchaseItem {
  id               String @id @default(cuid())
  shopId           String
  purchaseId       String
  productId        String
  qty              Int
  unitCostUsdCents Int

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shopId, purchaseId])
  @@index([shopId, productId])
}

// Money paid to a supplier (recorded, not processed). Cash can come out of the open drawer.
model SupplierPayment {
  id                 String        @id @default(cuid())
  shopId             String
  supplierId         String
  /// Paid together with a purchase (the "paid now" part), if any.
  purchaseId         String?
  method             PaymentMethod
  currency           Currency
  amount             Int
  rate               Int
  usdCentsEquivalent Int
  paidAt             DateTime
  note               String?
  cashMovementId     String?       @unique
  userId             String
  createdAt          DateTime      @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id])

  @@index([shopId, supplierId, paidAt])
}

// ---------- Messaging ----------

model MessageTemplate {
  id        String      @id @default(cuid())
  shopId    String
  key       TemplateKey
  locale    Locale
  body      String
  updatedAt DateTime    @updatedAt
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key, locale])
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
}

// Keep-alive marker (single row, id "keepalive"). /api/keepalive bumps it daily (Vercel Cron) so a free
// Supabase project never counts as inactive and gets paused. No business data.
model Heartbeat {
  id String   @id
  at DateTime @default(now())
}

// "Approve the new price" request sent to the customer as a WhatsApp link (public page /approve/<token>).
model PriceApproval {
  id               String         @id @default(cuid())
  shopId           String
  ticketId         String
  token            String         @unique
  /// New total price the customer is asked to accept (USD cents).
  amountUsdCents   Int
  /// What the ticket was charging when the request was made, shown for comparison.
  previousUsdCents Int?
  reason           String
  status           ApprovalStatus @default(PENDING)
  createdById      String
  createdAt        DateTime       @default(now())
  respondedAt      DateTime?
  /// Staff member who recorded the customer's answer (told in person or by phone); null = answered by link.
  answeredById     String?

  shop       Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy  User   @relation(fields: [createdById], references: [id])
  answeredBy User?  @relation("approvalAnswers", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([shopId, ticketId])
  @@index([shopId, status])
}

/// A sale or a repair paid in parts. Payments are the normal sale/ticket payments:
/// what was paid after the plan started fills the parts in order.
model InstallmentPlan {
  id                 String   @id @default(cuid())
  shopId             String
  customerId         String
  saleId             String?  @unique
  ticketId           String?  @unique
  /// What was left to pay when the plan was made (split into the parts).
  totalUsdCents      Int
  /// What was already paid on the sale/repair before the plan.
  paidBeforeUsdCents Int
  note               String?
  userId             String
  createdAt          DateTime @default(now())

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id])
  sale     Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticket   Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  parts    Installment[]

  @@index([shopId, customerId])
}

model Installment {
  id             String    @id @default(cuid())
  shopId         String
  planId         String
  number         Int
  /// Local day the part is due, stored at local noon.
  dueAt          DateTime
  amountUsdCents Int
  remindedAt     DateTime?

  shop Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, number])
  @@index([shopId, dueAt])
}
